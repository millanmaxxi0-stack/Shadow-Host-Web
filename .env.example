# Required
DATABASE_URL=postgres://user:pass@host:5432/db
JWT_SECRET=change-me-long-random-string
BASE_DOMAIN=example.com          # sites served at <slug>.example.com
S3_BUCKET=sh4d0w-sites
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional
S3_ENDPOINT=                     # e.g. https://<account>.r2.cloudflarestorage.com (R2) - empty for AWS
S3_REGION=auto
S3_FORCE_PATH_STYLE=false
DATABASE_SSL=false               # true if your managed DB requires SSL
PORT=3000
